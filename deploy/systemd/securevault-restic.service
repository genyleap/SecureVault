[Unit]
Description=SecureVault encrypted off-site backup
Documentation=file:///usr/local/share/doc/securevault/DISASTER-RECOVERY.md
Wants=network-online.target
After=network-online.target mariadb.service postgresql.service
Requires=mariadb.service postgresql.service
ConditionPathExists=/etc/securevault/restic.env

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=RESTIC_CACHE_DIR=/var/cache/securevault
EnvironmentFile=/etc/securevault/restic.env
ExecStart=/usr/local/libexec/securevault/backup-restic.sh
StateDirectory=securevault
CacheDirectory=securevault
RuntimeDirectory=securevault
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
TimeoutStartSec=8h
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/securevault /var/cache/securevault /run/securevault

[Install]
WantedBy=multi-user.target
