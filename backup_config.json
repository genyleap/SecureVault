{
    "backup_base": "/var/backups/securevault/",
    "backup_dirs": [
        "/var/www/",
        "/opt/",
        "/etc/nginx/",
        "/etc/systemd/system/",
        "/etc/postgresql/",
        "/etc/mysql/",
        "/boot/"
    ],
    "exclude_extensions": [
        ".tmp",
        ".cache"
    ],
    "retention_days": 30,
    "databases": [
        {
            "type": "mysql",
            "user": "root",
            "password": "",
            "host": "localhost",
            "port": 3306
        },
        {
            "type": "postgresql",
            "user": "postgres",
            "password": "",
            "host": "localhost",
            "port": 5432
        }
    ],
    "schedule": {
        "type": "daily",
        "time": "09:29:00",
        "day_of_week": "monday",
        "day_of_month": 1
    },
    "sftp": {
        "host": "",
        "port": 22,
        "user": "",
        "password": "",
        "remote_dir": "/backups/securevault/"
    },
    "telegram": {
        "bot_token": "your_bot_token",
        "chat_id": "your_chat_id"
    },
    "email": {
        "smtp_server": "",
        "smtp_port": 587,
        "email_to": "",
        "email_from": "",
        "username": "",
        "password": ""
    },
    "require_remote": true
}
